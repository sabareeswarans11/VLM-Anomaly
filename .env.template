# Copy this file to .env and fill in only the keys you actually need.
# .env is git-ignored. Do not commit secrets.

# ── Cloud VLM keys ─────────────────────────────────────────────────────────
TOGETHER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ── MLflow (optional; defaults to local ./mlruns) ──────────────────────────
MLFLOW_TRACKING_URI=

# ── Paths ──────────────────────────────────────────────────────────────────
VLM_ANOMALY_DATA_DIR=./data
VLM_ANOMALY_RESULTS_DIR=./results
VLM_ANOMALY_MODELS_DIR=./models

# ── Budgets ────────────────────────────────────────────────────────────────
VLM_ANOMALY_DEFAULT_BUDGET_USD=5
